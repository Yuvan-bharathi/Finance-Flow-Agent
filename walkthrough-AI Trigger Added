## 3. Database Schema Overview

```sql
-- agent_runs: Summary record per execution
CREATE TABLE agent_runs (
  id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
  agent_id VARCHAR(50) NOT NULL,
  agent_name VARCHAR(100) NOT NULL,
  case_id INT UNSIGNED NULL,
  triggered_by INT UNSIGNED NULL,
  trigger_type ENUM('manual','bulk_manual','system','retry','scheduled'),
  status ENUM('queued','processing','completed','failed'),
  pre_check_result ENUM('clear_match','ambiguous','no_match'),
  groq_called BOOLEAN DEFAULT FALSE,
  duration_ms INT UNSIGNED,
  model VARCHAR(100),
  input_tokens BIGINT UNSIGNED,
  output_tokens BIGINT UNSIGNED,
  total_tokens BIGINT UNSIGNED,
  tools_called JSON,
  confidence_score DECIMAL(5,2),
  result_summary TEXT,
  error_message TEXT,
  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- agent_execution_logs: Step-by-step execution timeline
CREATE TABLE agent_execution_logs (
  id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
  agent_run_id BIGINT UNSIGNED NOT NULL,
  agent_id VARCHAR(50) NOT NULL,
  step_type VARCHAR(50) NOT NULL,
  step_name VARCHAR(100) NOT NULL,
  status ENUM('started','completed','failed','skipped'),
  input_data JSON,
  output_data JSON,
  duration_ms INT UNSIGNED,
  error_message TEXT,
  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);
```

