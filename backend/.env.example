# =============================================================================
# FinanceFlow AI Backend — Environment Configuration Template
# =============================================================================

# --- 1. Server Environment ---
PORT=5000
NODE_ENV=development

# --- 2. Database Configuration (MySQL 8.0+ / TiDB Cloud / Aiven) ---
# Option A: Discrete Connection Parameters
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=financeflow_db
DB_SSL=false

# Option B: Unified Connection URL (Overrides discrete params if present)
# DATABASE_URL=mysql://username:password@host:port/database?ssl={"rejectUnauthorized":true}

# --- 3. Authentication & Security (JWT) ---
JWT_SECRET=financeflow_ai_super_secret_jwt_key_2026_production
JWT_EXPIRES_IN=1d
COOKIE_SECRET=financeflow_ai_cookie_secret_key_2026

# --- 4. Groq LLM API Configuration (Agentic Layer) ---
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.6-27b

# --- 5. Storage & File Processing ---
UPLOAD_DIR=uploads
STORAGE_PROVIDER=local

# --- 6. CORS & Frontend Origin ---
# In development: http://localhost:5173
# In production: https://finance-flow-agent.vercel.app or *
CLIENT_URL=http://localhost:5173

# --- 7. Multi-Agent Operational Thresholds ---
RECONCILIATION_PRECHECK_THRESHOLD=85
MAX_BULK_CASES=50
MAX_SELECTED_CASES=20
MAX_CONCURRENT_AGENT_RUNS=5
